@@ -0,0 +1,15 @@
+/* PROTÓTIPO — ajustes de legibilidade e acento do astrolábio (admin).
+   Carregado depois de admin-astrolabe-unified.css. Não altera dados, rotas nem eventos.
+   1) Legendas com no mínimo 10px.
+   2) Cauda da agulha em bronze; carmesim fica restrito à seleção ativa.
+   3) Aura mais lenta (2.6 s), menos dominante. */
+:root.qb-admin-experience .qb-radial-hub.qb-admin-astro .qb-radial-node-caption,
+:root.qb-admin-experience .qb-radial-hub.qb-admin-astro .qb-radial-node-label{
+  font-size:max(10px,var(--qb-astro-min,10px))!important;
+}
+:root.qb-admin-experience .qb-radial-hub.qb-admin-astro .qb-astro-needles path[stroke="#9B4442"]{
+  stroke:#A69277!important;
+}
+:root.qb-admin-experience .qb-radial-hub.qb-admin-astro .qb-radial-node:is(:hover,:focus-visible,.is-focused,.qb-admin-pressed,.qb-astro-selected):not(:disabled)::before{
+  animation-duration:2.6s!important;
+}
