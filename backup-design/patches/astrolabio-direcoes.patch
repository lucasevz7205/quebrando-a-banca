diff --git a/public/claude-export/admin-astrolabe-base.css b/public/claude-export/admin-astrolabe-base.css
new file mode 100644
index 0000000..7a2a10f
--- /dev/null
+++ b/public/claude-export/admin-astrolabe-base.css
@@ -0,0 +1,22 @@
+/* PROTÓTIPO — astrolábio: direções N/L/S/O, graduação e números em camada sobre um disco sem textos antigos.
+   Menu principal: sem ícone e palavras no centro (só o ponteiro e o ornamento ficam).
+   Não altera dados, rotas nem eventos. Substitui astrolabio-ajustes-2 e astrolabio-direcoes anteriores. */
+:root.qb-admin-experience .qb-radial-hub.qb-admin-astro .qb-astro-disc{
+  background:
+    url("/claude-export/admin-astrolabe-direcoes.svg") center/100% 100% no-repeat,
+    url("/claude-export/admin-astrolabe-base.svg") center/100% 100% no-repeat!important;
+}
+:root.qb-admin-experience .qb-radial-hub.qb-admin-astro[data-radial-screen="menu"] .qb-radial-core-eyebrow,
+:root.qb-admin-experience .qb-radial-hub.qb-admin-astro[data-radial-screen="menu"] .qb-radial-core-sub,
+:root.qb-admin-experience .qb-radial-hub.qb-admin-astro[data-radial-screen="menu"] .qb-radial-core strong,
+:root.qb-admin-experience .qb-radial-hub.qb-admin-astro[data-radial-screen="menu"] .qb-radial-core-orb{
+  display:none!important;
+}
+:root.qb-admin-experience .qb-radial-hub.qb-admin-astro[data-radial-screen="menu"] .qb-radial-core{
+  width:clamp(64px,19%,92px)!important;
+}
+@media(max-width:760px){
+  :root.qb-admin-experience .qb-radial-hub.qb-admin-astro[data-radial-screen="menu"] [data-radial-stage]{
+    width:min(100%,380px)!important;
+  }
+}
