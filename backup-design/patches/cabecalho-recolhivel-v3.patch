diff --git a/public/claude-export/admin-cabecalho-recolhivel.css b/public/claude-export/admin-cabecalho-recolhivel.css
new file mode 100644
index 0000000..7ad70dd
--- /dev/null
+++ b/public/claude-export/admin-cabecalho-recolhivel.css
@@ -0,0 +1,21 @@
+/* Faixa superior do admin recolhível. Recolhida: some OmniStudy, sincronizado, fundo, topo, tema e ferramentas.
+   O relógio da prova fica junto ao rótulo do concurso (fora da faixa). Não altera dados nem rotas.
+   O :not(#qb-x) eleva a especificidade acima das regras do app que usam :is(... #omni-studio-trigger). */
+:root.qb-admin-experience header.top.qb-app-header.qb-cabecalho-recolhido .qb-header-utilities > *:not(.qb-cabecalho-toggle):not(#qb-x):not(#qb-y){
+  display:none!important;
+}
+:root.qb-admin-experience header.top.qb-app-header .qb-header-utilities > .qb-cabecalho-toggle{
+  display:inline-flex!important;align-items:center;gap:6px;order:70;
+  padding:6px 12px;border-radius:999px;cursor:pointer;min-height:34px;
+  border:1px solid rgba(165,138,103,.7);background:rgba(10,30,52,.82);
+  color:#E9DEC9;font:600 12px/1 system-ui,sans-serif;
+}
+.qb-cabecalho-toggle:focus-visible{outline:2px solid #D0B386;outline-offset:2px;}
+.qb-cabecalho-toggle::after{content:"▴";font-size:11px;transition:transform .25s ease;}
+header.top.qb-app-header.qb-cabecalho-recolhido .qb-cabecalho-toggle::after{transform:rotate(180deg);}
+:root.qb-admin-experience header.top.qb-app-header > #countdown{
+  display:inline-flex!important;margin:2px 0 0 10px;vertical-align:middle;
+}
+@media(prefers-reduced-motion:reduce){
+  .qb-cabecalho-toggle::after{transition:none!important;}
+}
diff --git a/public/claude-export/admin-cabecalho-recolhivel.js b/public/claude-export/admin-cabecalho-recolhivel.js
new file mode 100644
index 0000000..738d976
--- /dev/null
+++ b/public/claude-export/admin-cabecalho-recolhivel.js
@@ -0,0 +1,40 @@
+/* Recolher/expandir a faixa superior do admin e subir o relógio da prova para junto do rótulo do concurso.
+   O relógio só muda de lugar depois que o botão de sincronização existe, porque offline-sync.js usa o
+   relógio como referência (insertBefore) ao montar. */
+(function () {
+  "use strict";
+  function mount(header) {
+    const utilities = header.querySelector(".qb-header-utilities");
+    if (!utilities || utilities.querySelector(".qb-cabecalho-toggle")) return;
+    const btn = document.createElement("button");
+    btn.type = "button";
+    btn.className = "qb-cabecalho-toggle";
+    btn.setAttribute("aria-expanded", "true");
+    btn.appendChild(document.createTextNode("Recolher"));
+    btn.addEventListener("click", function () {
+      const collapsed = header.classList.toggle("qb-cabecalho-recolhido");
+      btn.setAttribute("aria-expanded", collapsed ? "false" : "true");
+      btn.firstChild.nodeValue = collapsed ? "Expandir" : "Recolher";
+    });
+    utilities.appendChild(btn);
+  }
+  function placeCountdown(header) {
+    const countdown = document.getElementById("countdown");
+    const kicker = header.querySelector(".qb-header-kicker");
+    if (!countdown || !kicker || !document.getElementById("qb-sync-status")) return;
+    if (kicker.nextElementSibling !== countdown) kicker.insertAdjacentElement("afterend", countdown);
+  }
+  function scan() {
+    if (!document.documentElement.classList.contains("qb-admin-experience")) return;
+    const header = document.querySelector("header.top.qb-app-header");
+    if (!header) return;
+    mount(header);
+    placeCountdown(header);
+  }
+  function init() {
+    new MutationObserver(scan).observe(document.documentElement, { subtree: true, childList: true, attributes: true, attributeFilter: ["class"] });
+    scan();
+  }
+  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init, { once: true });
+  else init();
+})();
