index 0000000..1a127ce
--- /dev/null
+++ b/public/claude-export/admin-estudo-padrao.css
@@ -0,0 +1,84 @@
+/* Padrão visual do admin para todas as seções (Hoje, Edital, Treinar, Estudo, Simulado, Desempenho): mesmos cabeçalhos,
+   botões, filtros, cartões, etiquetas e barra de baralho. Só aparência. */
+:root.qb-admin-experience #main :is(.btn,button.lnk,.seg button){min-height:44px}
+:root.qb-admin-experience #main .btn:not(.ghost){
+  border:1.5px solid var(--qbds-gold);background:rgba(208,179,134,.16);color:var(--qbds-cream);box-shadow:none;
+}
+:root.qb-admin-experience #main .btn:not(.ghost):hover:not(:disabled){background:rgba(208,179,134,.28)}
+:root.qb-admin-experience #main .btn.ghost{
+  border:1px solid rgba(165,138,103,.6);background:rgba(23,54,83,.9);color:var(--qbds-cream-2);
+}
+:root.qb-admin-experience #main .btn.ghost:hover:not(:disabled){border-color:var(--qbds-gold);color:var(--qbds-cream);background:rgba(30,68,102,.9)}
+:root.qb-admin-experience #main :is(.btn,button,select,textarea,input,summary):focus-visible{outline:2px solid var(--qbds-gold);outline-offset:2px}
+:root.qb-admin-experience #main button.lnk{color:var(--qbds-gold)}
+:root.qb-admin-experience #main .filters{
+  border:1px solid rgba(165,138,103,.5);border-radius:16px;background:rgba(17,40,63,.9);color:var(--qbds-cream-2);
+}
+:root.qb-admin-experience #main :is(.filters select,.filters input[type="text"],.qb-map3-footer select){
+  background:var(--qbds-navy-900);border:1.5px solid var(--qbds-bronze);color:var(--qbds-cream);border-radius:10px;min-height:44px;
+}
+:root.qb-admin-experience #main .notice{
+  border:1px solid rgba(165,138,103,.5);background:rgba(17,40,63,.9);color:var(--qbds-cream-2);border-radius:14px;
+}
+:root.qb-admin-experience #main :is(.tag,.tchip[class="tchip"]){
+  border:1px solid rgba(165,138,103,.6);background:rgba(23,54,83,.8);color:var(--qbds-gold);font-weight:700;letter-spacing:.06em;
+}
+/* Questões */
+:root.qb-admin-experience #main .item{
+  border:1.5px solid var(--qbds-bronze);border-radius:20px;
+  background:linear-gradient(160deg,rgba(23,54,83,.95),rgba(10,30,52,.96));
+  box-shadow:inset 0 1px 0 rgba(208,179,134,.2),0 12px 30px rgba(0,0,0,.35);color:var(--qbds-cream-2);
+}
+:root.qb-admin-experience #main .item .item-num{color:var(--qbds-gold)}
+:root.qb-admin-experience #main .item .statement{font-family:Georgia,"Times New Roman",serif;color:var(--qbds-cream)}
+:root.qb-admin-experience #main .item .statement .lbl{color:var(--qbds-kicker);letter-spacing:.14em}
+:root.qb-admin-experience #main .item .answers :is(.bubble,.qb-mc-choice,.blank):not(.picked):not(.key){
+  border:1.5px solid var(--qbds-bronze);background:rgba(23,54,83,.9);color:var(--qbds-cream);
+}
+:root.qb-admin-experience #main .item .answers :is(.bubble,.qb-mc-choice,.blank).picked{border-color:var(--qbds-gold);background:rgba(208,179,134,.18);color:var(--qbds-cream)}
+:root.qb-admin-experience #main .item .answers :is(.bubble,.qb-mc-choice,.blank):focus-visible{outline:2px solid var(--qbds-gold);outline-offset:2px}
+:root.qb-admin-experience #main .item .just{border-top:1px dashed rgba(208,179,134,.5)}
+:root.qb-admin-experience #main .item .just textarea{background:var(--qbds-navy-900);border:1.5px solid var(--qbds-bronze);color:var(--qbds-cream)}
+:root.qb-admin-experience #main .item .just label,
+:root.qb-admin-experience #main .item .conf-q{color:var(--qbds-cream-2)}
+@media(prefers-reduced-motion:reduce){:root.qb-admin-experience #main .item *{transition:none!important}}
+
+/* Cabeçalho de seção e cartões de apresentação (todas as seções) */
+:root.qb-admin-experience :is(.qb-page-hero,.qb-section-intro.qb-page-hero,.qb-plan-intro.qb-page-hero,.qb-analytics-intro.qb-page-hero,.qb-welcome,.qb-trap-overview,.qb-trap-next,.learn-pilot-intro,.qb-study-pulse){
+  border:1.5px solid var(--qbds-bronze);border-radius:22px;
+  background:radial-gradient(ellipse 60% 130% at 55% -31%,rgba(30,68,102,.9),transparent 80%),linear-gradient(160deg,rgba(23,54,83,.95),rgba(10,30,52,.96));
+  box-shadow:inset 0 1px 0 rgba(208,179,134,.2),0 12px 30px rgba(0,0,0,.35);
+}
+:root.qb-admin-experience :is(.qb-section-kicker,.qb-page-kicker,.qb-radial-overline){color:var(--qbds-kicker)!important;letter-spacing:.14em}
+:root.qb-admin-experience :is(.qb-page-hero,.qb-section-intro) h2{color:var(--qbds-cream)!important;font-family:Georgia,"Times New Roman",serif}
+:root.qb-admin-experience :is(.qb-page-hero,.qb-section-intro) p{color:var(--qbds-sand)!important}
+/* Barra de progresso do baralho e barras de placar */
+:root.qb-admin-experience #main .scorebar{
+  border:1px solid rgba(165,138,103,.5);border-radius:16px;background:rgba(17,40,63,.9);color:var(--qbds-cream-2);
+}
+:root.qb-admin-experience #main .scorebar .progress,
+:root.qb-admin-experience #main .scorebar .mono{color:var(--qbds-gold)}
+:root.qb-admin-experience #main progress{accent-color:var(--qbds-gold);background:rgba(165,138,103,.25);border-radius:6px}
+:root.qb-admin-experience #main progress::-webkit-progress-bar{background:rgba(165,138,103,.25);border-radius:6px}
+:root.qb-admin-experience #main progress::-webkit-progress-value{background:linear-gradient(90deg,var(--qbds-bronze),var(--qbds-gold));border-radius:6px}
+:root.qb-admin-experience #main progress::-moz-progress-bar{background:var(--qbds-gold);border-radius:6px}
+/* Cartões de lista e ramos do mapa */
+:root.qb-admin-experience #main .card-r:not(.qb-flashcard){
+  border:1px solid rgba(165,138,103,.5);background:rgba(17,40,63,.9);color:var(--qbds-cream-2);
+}
+:root.qb-admin-experience #main .m-ramo .m-l{
+  background:rgba(23,54,83,.85);border:1px solid rgba(165,138,103,.5);border-left:4px solid var(--mc,var(--qbds-bronze));color:var(--qbds-cream);
+}
+:root.qb-admin-experience #main .m-ramo .m-t{color:var(--qbds-cream)}
+:root.qb-admin-experience #main .m-ramo .m-nota{background:rgba(23,54,83,.7);border:1px solid rgba(165,138,103,.5);color:var(--qbds-cream-2)}
+
+/* Redundância além da cor (WCAG 1.4.1): estado "escolhida" e veredito ganham ícone, e o nó selecionado do mapa, sublinhado. */
+:root.qb-admin-experience #main .item .answers :is(.bubble,.blank){position:relative}
+:root.qb-admin-experience #main .item .answers :is(.bubble,.blank).picked::after{
+  content:"✓";position:absolute;top:-8px;right:-6px;width:18px;height:18px;border-radius:50%;
+  background:var(--qbds-primary);color:var(--qbds-primary-foreground);font:800 12px/18px system-ui,sans-serif;text-align:center;
+}
+:root.qb-admin-experience #main .verdict.ok .vt::before{content:"✓ "}
+:root.qb-admin-experience #main .verdict.bad .vt::before{content:"✕ "}
+:root.qb-admin-experience #main .verdict.dub .vt::before{content:"? "}
+:root.qb-admin-experience #main .qb-map3-tag[aria-pressed="true"]{text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:3px}
