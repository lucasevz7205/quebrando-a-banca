+/* Mapa mental e flashcards no visual do admin (azul-marinho, bronze e dourado). Só aparência: nenhuma função muda. */
+:root.qb-admin-experience .qb-map3-stage{
+  --axon-blue:#D0B386;--axon-lilac:#A58A67;
+  border:1px solid rgba(165,138,103,.55);border-radius:18px;
+  background:radial-gradient(circle at 50% 50%,rgba(23,54,83,.96),rgba(10,30,52,.98) 72%);
+  box-shadow:inset 0 1px 0 rgba(208,179,134,.18);
+}
+:root.qb-admin-experience .qb-map3-concept-backdrop{
+  background:radial-gradient(ellipse at 52% 40%,rgba(23,54,83,.78) 0%,rgba(8,22,40,.9) 66%,rgba(6,16,30,.94) 100%);
+}
+:root.qb-admin-experience .qb-map3-concept-card{
+  border:1.5px solid #A58A67;background:linear-gradient(180deg,#14304D,#0A1E34);
+  box-shadow:0 18px 40px rgba(0,0,0,.45),inset 0 1px 0 rgba(208,179,134,.2);
+}
+:root.qb-admin-experience .qb-map3-concept-head{border-bottom:1px solid rgba(165,138,103,.4);background:rgba(23,54,83,.45)}
+:root.qb-admin-experience .qb-map3-concept-kicker{color:#D0B386;text-shadow:none}
+:root.qb-admin-experience .qb-map3-concept-head p{color:#C9BEA8}
+:root.qb-admin-experience .qb-map3-concept .qb-map3-detail h3{color:#F1E8D5;font-family:Georgia,"Times New Roman",serif}
+:root.qb-admin-experience .qb-map3-concept .qb-map3-detail{color:#E9DEC9}
+:root.qb-admin-experience .qb-map3-concept .qb-map3-detail .m-det p{color:#E9DEC9}
+:root.qb-admin-experience .qb-map3-concept .qb-map3-detail :is(summary,.lnk,.m-t){color:#D0B386}
+:root.qb-admin-experience .qb-map3-concept .qb-map3-detail .m-nota{background:rgba(23,54,83,.7);border:1px solid rgba(165,138,103,.5)}
+:root.qb-admin-experience .qb-map3-concept-close{
+  min-width:44px;min-height:44px;border:1px solid rgba(165,138,103,.6);background:rgba(10,30,52,.8);color:#E9DEC9;
+}
+:root.qb-admin-experience .qb-map3-concept-foot{border-top:1px solid rgba(165,138,103,.4);background:rgba(10,30,52,.7);color:#C9BEA8}
+:root.qb-admin-experience .qb-map3-stage :is(button,a,[tabindex]):focus-visible{outline:2px solid #D0B386;outline-offset:2px}
+
+/* Flashcards */
+:root.qb-admin-experience .qb-flashcard{
+  border:1.5px solid #A58A67;border-left:4px solid #A58A67;border-radius:20px;
+  background:linear-gradient(160deg,rgba(23,54,83,.95),rgba(10,30,52,.96));
+  box-shadow:inset 0 1px 0 rgba(208,179,134,.2),0 12px 30px rgba(0,0,0,.35);
+  color:#E9DEC9;
+}
+:root.qb-admin-experience .qb-flashcard:hover{box-shadow:inset 0 1px 0 rgba(208,179,134,.25),0 16px 34px rgba(0,0,0,.4)}
+:root.qb-admin-experience .qb-flashcard .cq{font-family:Georgia,"Times New Roman",serif;color:#F1E8D5}
+:root.qb-admin-experience .qb-flashcard .qb-flash-state{
+  background:transparent;color:#B79F78;border:0;letter-spacing:.14em;font-weight:700;text-transform:uppercase;font-size:11px;
+}
+:root.qb-admin-experience .qb-flashcard[data-revealed="true"]{border-left-color:#D0B386}
+:root.qb-admin-experience .qb-flashcard[data-revealed="true"] .qb-flash-state{background:transparent;color:#D0B386}
+:root.qb-admin-experience .qb-flashcard textarea{
+  background:rgba(10,30,52,.9);border:1.5px solid #A58A67;color:#F1E8D5;
+}
+:root.qb-admin-experience .qb-flashcard textarea:focus{outline:2px solid #D0B386;outline-offset:1px}
+:root.qb-admin-experience .qb-flashcard .srs{
+  min-height:52px;border-radius:14px;border:1.5px solid #A58A67;background:rgba(23,54,83,.9);color:#F1E8D5;font-weight:700;
+}
+:root.qb-admin-experience .qb-flashcard .srs-n{border-color:#A92E3A;background:rgba(169,46,58,.2)}
+:root.qb-admin-experience .qb-flashcard .srs-d{border-color:#A58A67}
+:root.qb-admin-experience .qb-flashcard .srs-b,
+:root.qb-admin-experience .qb-flashcard .srs-f{border-color:#D0B386;background:rgba(208,179,134,.16)}
+:root.qb-admin-experience .qb-flashcard .srs:focus-visible{outline:2px solid #D0B386;outline-offset:2px}
+:root.qb-admin-experience .qb-flashcard-focus .cq{font-size:clamp(20px,3vw,28px)!important}
+@media (max-width:600px){:root.qb-admin-experience .qb-flashcard .srs{min-height:56px}}
+@media (prefers-reduced-motion:reduce){:root.qb-admin-experience .qb-flashcard{transition:none}}
