{
  "name": "StudyAccount",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "exam_name": {
      "type": "string"
    },
    "exam_date": {
      "type": "string",
      "format": "date"
    },
    "active": {
      "type": "boolean",
      "default": false
    },
    "access_pending": {
      "type": "boolean"
    },
    "access_requested_at": {
      "type": "number"
    }
  },
  "required": [
    "user_id",
    "exam_name",
    "active"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}
